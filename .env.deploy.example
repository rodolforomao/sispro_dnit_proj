# Credenciais SSH para deploy do SISPRO (NÃO versionar — copie para .env.deploy)
SSH_HOST=10.100.11.235
SSH_USER=rodolfo.neto
SSH_PORT=22
SSH_PASSWORD=

# Destino no servidor (pasta física servida em /sispro)
